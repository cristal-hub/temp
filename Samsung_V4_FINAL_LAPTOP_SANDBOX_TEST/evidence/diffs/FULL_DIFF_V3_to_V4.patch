+class _FakeClient:
+    """Минимальный двойник TinkoffClient для проверки guard'а."""
+
+    def __init__(self):
+        self.post_market_order = lambda *a, **k: "REAL_ORDER_SENT"
+        self.cancel_order = lambda *a, **k: "REAL_CANCEL_SENT"
+        self.uncertain_state = False
