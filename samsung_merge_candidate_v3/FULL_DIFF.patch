+    exch_id = pos.close_order_id
+    oid = str(req_id or exch_id or "")
+    if not oid:
+        # Нет ссылки на СВОЮ close-заявку (например, B3-внешнее закрытие):
+        # опрос невозможен, строка остаётся как записана (B3 не меняется).
+        if _csv_recovery_once(pos, "no_refs"):
+            logging.debug(
+                f"[csv-recovery] {pos.ticker}: нет ссылки на close-заявку — "
+                f"восстановление метаданных не требуется/невозможно")
+        return
+    cursor = (getattr(pos, "close_orders", {}) or {}).get(oid)
+    if cursor is None:
+        if _csv_recovery_once(pos, f"no_cursor:{oid}"):
+            logging.warning(
+                f"[csv-recovery] {pos.ticker}: per-order cursor для {oid} "
+                f"отсутствует — восстановление метаданных невозможно")
+        return
+    cur_status = _canonical_report_status(cursor.get("status"))
+    if cur_status not in _SELL_JOURNAL_TERMINAL_STATUSES:
+        if _csv_recovery_once(pos, f"cursor_not_terminal:{oid}"):
+            logging.warning(
+                f"[csv-recovery] {pos.ticker}: cursor {oid} не терминален "
+                f"({cursor.get('status')}) — восстановление не выполняется")
+        return
+    try:
+        confirmed = int(cursor.get("confirmed_executed_lots") or 0)
+        applied = int(cursor.get("applied_lots") or 0)
+    except (TypeError, ValueError):
+        logging.error(
+            f"[csv-recovery] {pos.ticker}: некорректный cursor {oid} — "
+            f"восстановление не выполняется (fail-closed)")
+        return
+    if confirmed <= 0 or confirmed != applied:
+        if _csv_recovery_once(pos, f"cursor_partial:{oid}"):
+            logging.warning(
+                f"[csv-recovery] {pos.ticker}: cursor {oid} "
+                f"(confirmed={confirmed}, applied={applied}) не согласован — "
+                f"восстановление не выполняется")
+        return
+
+    # --- 1. Исходная строка по стабильному trade_id ---
+    find_status, old_row = research_logger.find_trade_row(trade_id)
+    if find_status != "found":
+        key = f"row_{find_status}"
+        if _csv_recovery_once(pos, key):
+            level = logging.error if find_status in ("ambiguous", "error") else logging.info
+            level(
+                f"[csv-recovery] {pos.ticker}: строка trade_id={trade_id} — "
+                f"{find_status}: обновление не выполняется")
+            if find_status == "ambiguous":
+                research_logger.log_event("CSV_LATE_METADATA_CONFLICT", {
+                    "figi": pos.figi, "ticker": pos.ticker,
+                    "trade_id": trade_id, "reason": "ambiguous_trade_id",
+                })
+        return
+
+    # --- 2. Нужен ли опрос: неполные подтверждённые данные в строке ---
+    row_price = str(old_row.get("exit_price") or "").strip()
+    row_actual_comm = str(old_row.get("actual_commission_rub") or "").strip()
+    needs_poll = (not row_price) or (not row_actual_comm)
+    if not needs_poll:
+        # Цена и фактическая комиссия уже подтверждены и записаны —
+        # опрос не требуется (комиссия source=mixed корректна, когда
+        # входная комиссия модельная: close-заявка её не уточняет).
+        _csv_recovery_once(pos, "complete")
+        return
+
+    # --- 3. Опрос отчёта брокера (семантика resolve_closing) ---
+    try:
+        if exch_id:
+            state = await client.get_sandbox_order_state(
+                str(exch_id), order_id_type="EXCHANGE")
+        else:
+            state = await client.get_sandbox_order_state(
+                str(req_id), order_id_type="REQUEST")
+    except Exception as exc:
+        logging.warning(
+            f"[csv-recovery] {pos.ticker}: запрос отчёта {oid} не удался: "
+            f"{type(exc).__name__}: {exc} — состояние неизвестно, "
+            f"изменений нет (fail-closed)")
+        return
+    if state is None:
+        _csv_recovery_once(pos, f"state_none:{oid}")
+        return
+    raw_status = getattr(state, "execution_report_status", None)
+    report_status = _canonical_report_status(raw_status)
+    try:
+        lots = int(getattr(state, "lots_executed", 0) or 0)
+    except (TypeError, ValueError):
+        lots = -1
+    price = ExecutionMonitor._extract_price(state, lots, pos.lot_size or 1)
+    commission = ExecutionMonitor._extract_commission(state)
+
+    # --- 4. Идентичность отчёта замороженному терминальному cursor'у ---
+    if (report_status not in _SELL_JOURNAL_TERMINAL_STATUSES
+            or report_status != cur_status):
+        logging.error(
+            f"[csv-recovery] {pos.ticker}: отчёт {oid} имеет статус "
+            f"{report_status or 'неизвестно'}, учтённый терминальный — "
+            f"{cur_status}: сверка невозможна, изменения запрещены "
+            f"(fail-closed)")
+        research_logger.log_event("CSV_LATE_METADATA_CONFLICT", {
+            "figi": pos.figi, "ticker": pos.ticker, "order_id": oid,
+            "trade_id": trade_id, "reason": "status",
+            "reported_status": report_status, "saved_status": cur_status,
+        })
+        return
+    if lots != confirmed:
+        logging.error(
+            f"[csv-recovery] {pos.ticker}: отчёт {oid} cumulative={lots} "
+            f"при учтённом терминальном {confirmed}: рост/спад исполнения "
+            f"после терминала — изменения запрещены (fail-closed)")
+        research_logger.log_event("CSV_LATE_METADATA_CONFLICT", {
+            "figi": pos.figi, "ticker": pos.ticker, "order_id": oid,
+            "trade_id": trade_id, "reason": "lots",
+            "reported_lots": lots, "saved_lots": confirmed,
+        })
+        return
+    if _confirmed_value_conflicts(cursor.get("avg_exec_price"), price) or \
+            _confirmed_value_conflicts(cursor.get("commission"), commission):
+        logging.error(
+            f"[csv-recovery] {pos.ticker}: отчёт {oid} противоречит "
+            f"учтённым значениям (price: {price} vs "
+            f"{cursor.get('avg_exec_price')}; commission: {commission} vs "
+            f"{cursor.get('commission')}) — изменения запрещены "
+            f"(fail-closed, подтверждённые значения не перезаписываются)")
+        research_logger.log_event("CSV_LATE_METADATA_CONFLICT", {
+            "figi": pos.figi, "ticker": pos.ticker, "order_id": oid,
+            "trade_id": trade_id, "reason": "price_or_commission",
+            "reported_price": price, "saved_price": cursor.get("avg_exec_price"),
+            "reported_commission": commission,
+            "saved_commission": cursor.get("commission"),
+        })
+        return
+
+    # --- 5. Безопасное обогащение ТОЛЬКО отсутствующих значений ---
+    enriched = []
+    if price is not None and price > 0 and cursor.get("avg_exec_price") is None:
+        cursor["avg_exec_price"] = float(price)
+        enriched.append("avg_exec_price")
+    if commission is not None and cursor.get("commission") is None:
+        cursor["commission"] = float(commission)
+        enriched.append("commission")
+    if enriched:
+        # Синхронизация legacy-полей позиции с обогащённым cursor'ом
+        # (та же семантика, что v2.3.5-stage1 в apply_close_execution).
+        pos.execution_price = cursor.get("avg_exec_price")
+        pos.exit_price_confirmed = cursor.get("avg_exec_price") is not None
+        pos.actual_commission = cursor.get("commission")
+        logging.info(
+            f"[csv-recovery] {pos.ticker}: поздние метаданные брокера для "
+            f"{oid} восстановлены в cursor/позицию: {', '.join(enriched)} "
+            f"(лоты уже учтены: {confirmed}, без повторного применения)")
+        research_logger.log_event("CSV_LATE_METADATA_ENRICHED", {
+            "figi": pos.figi, "ticker": pos.ticker, "order_id": oid,
+            "trade_id": trade_id, "enriched": enriched,
+            "execution_price": pos.execution_price,
+            "actual_commission": pos.actual_commission,
+        })
+
+    # --- 6. Атомарное обновление существующей CSV-строки ---
+    updates = _build_late_recovery_updates(pos, old_row)
+    if not updates:
+        return  # нечего обновлять (идемпотентность)
+    upd_status, _updated_row = research_logger.update_trade_row(trade_id, updates)
+    if upd_status == "updated":
+        logging.info(
+            f"[csv-recovery] {pos.ticker}: CSV-строка trade_id={trade_id} "
+            f"обновлена (поля: {', '.join(sorted(updates))}) — "
+            f"накопительный P&L пересчитан")
+        research_logger.log_event("CSV_TRADE_ROW_UPDATED", {
+            "figi": pos.figi, "ticker": pos.ticker, "trade_id": trade_id,
+            "order_id": oid, "updated_fields": sorted(updates),
+            "updates": updates,
+        })
+    elif upd_status in ("missing", "ambiguous", "error"):
+        logging.error(
+            f"[csv-recovery] {pos.ticker}: обновление CSV trade_id="
+            f"{trade_id} не выполнено ({upd_status}) — исходный файл "
+            f"не изменён (fail-closed)")
+        research_logger.log_event("CSV_LATE_METADATA_CONFLICT", {
+            "figi": pos.figi, "ticker": pos.ticker, "trade_id": trade_id,
+            "reason": f"update_refused_{upd_status}",
+        })
+    else:  # "unchanged" — идемпотентный повтор
+        _csv_recovery_once(pos, f"update_unchanged:{trade_id}")
