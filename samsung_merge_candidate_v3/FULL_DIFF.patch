+def _remove_price_unknown_marker(note: str) -> str:
+    """v2.3.6-stage1: убирает стандартную пометку PRICE_UNKNOWN из error_note,
+    когда цена исполнения подтверждена поздним отчётом брокера. Остальные
+    пометки (например, «частичное исполнение SELL (3/10)») сохраняются
+    без изменений. Строка без пометки возвращается как есть."""
+    base = str(note or "")
+    if _CSV_PRICE_UNKNOWN_MARKER not in base:
+        return base
+    cleaned = base.replace(_CSV_PRICE_UNKNOWN_MARKER, "")
+    cleaned = cleaned.strip().strip(";").strip()
+    cleaned = cleaned.rstrip(";").strip()
+    return cleaned
+
