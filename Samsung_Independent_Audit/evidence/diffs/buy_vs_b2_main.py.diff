+def _enrich_buy_entry_metadata(monitor: ExecutionMonitor, rm: RiskManager,
+                               pos, *, entry_commission, exec_price,
+                               order_id: str, source: str) -> bool:
+    """BUY ACCOUNTING AUDIT (v1, FIX-4): позднее обогащение существующей
+    записи позиции подтверждёнными метаданными брокера (ТЗ-E).
+
+    Правила:
+      * заполняются ТОЛЬКО отсутствующие значения (None):
+        entry_actual_commission (комиссия BUY-исполнения) и execution_price
+        (цена BUY-исполнения — актуальна для RECOVERY-записей, у которых
+        цена была неизвестна при регистрации);
+      * уже сохранённые значения НЕ перезаписываются (конфликт значений
+        идентифицируется на уровне реестра заявок — FIX-1 в order_ledger);
+      * лоты, цена входа (entry_price), SL/TP и состояние позиции НЕ
+        меняются — обогащаются только метаданные;
+      * каждое изменение немедленно сохраняется в state.json
+        (_save_state_checked) — реестр и state утверждают одно и то же.
+
+    Возвращает True, если хотя бы одно поле заполнено."""
+    if pos is None:
+        return False
+    enriched = []
+    try:
+        if entry_commission is not None and pos.entry_actual_commission is None:
+            value = float(entry_commission)
+            if value >= 0:
+                pos.entry_actual_commission = value
+                enriched.append("entry_commission")
+        if (exec_price is not None and float(exec_price) > 0
+                and pos.execution_price is None):
+            pos.execution_price = float(exec_price)
+            enriched.append("execution_price")
+    except (TypeError, ValueError):
+        return False
+    if not enriched:
+        return False
+    research_logger.log_event("BUY_ENTRY_METADATA_ENRICHED", {
+        "figi": pos.figi, "ticker": pos.ticker, "order_id": order_id,
+        "enriched": enriched,
+        "entry_commission": pos.entry_actual_commission,
+        "execution_price": pos.execution_price,
+        "position_state": pos.state.value if pos.state else None,
+        "source": source,
+    })
+    _save_state_checked(monitor, rm)
+    return True
+
