+def _parse_csv_ts(value):
+    """v2.3.7-stage1 (V4): разбор ISO-timestamp из ячейки CSV.
+
+    Возвращает datetime (tz-aware; naive трактуется как UTC — журнал
+    ведётся в UTC) или None, если значение пустое/некорректное.
+    Никаких подстановок текущего времени: None = "время неизвестно"."""
+    raw = str(value or "").strip()
+    if not raw:
+        return None
+    try:
+        dt = datetime.fromisoformat(raw.replace("Z", "+00:00"))
+    except (TypeError, ValueError):
+        return None
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    return dt
+
+
+def _row_chrono_key(row, index):
+    """v2.3.7-stage1 (V4): ключ хронологической сортировки строки закрытия.
+
+    АВТОРИТЕТНОЕ ВРЕМЯ ЗАКРЫТИЯ — столбец exit_time (время запроса
+    закрытия позиции close-заявкой; для закрытий без своей заявки —
+    момент фиксации закрытия при записи строки; фиксируется ОДИН раз
+    при записи и не меняется при recovery-обновлениях).
+
+    Детерминированная fallback-цепочка — ТОЛЬКО поля самой строки, в
+    порядке убывания близости к моменту закрытия:
+      exit_time -> timestamp_utc (время запроса закрытия) ->
+      order_send_time (отправка SELL) -> signal_time.
+    Полностью неизвестное/некорректное время — фиксированный якорь
+    _CHRONO_UNKNOWN_TS (строка сортируется первой; НЕ текущее системное
+    время — повторный запуск не меняет результат).
+
+    Tie-breaker одинаковых меток времени — trade_id (лексикографически),
+    затем индекс строки в файле (гарантия полного порядка даже при
+    дублирующихся trade_id)."""
+    for field in ("exit_time", "timestamp_utc", "order_send_time",
+                  "signal_time"):
+        dt = _parse_csv_ts(row.get(field))
+        if dt is not None:
+            return (dt, str(row.get("trade_id") or ""), index)
+    return (_CHRONO_UNKNOWN_TS, str(row.get("trade_id") or ""), index)
+
