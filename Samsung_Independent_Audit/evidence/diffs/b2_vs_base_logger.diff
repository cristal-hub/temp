+def _recompute_cumulative(rows):
+    """v2.3.7-stage1 (V4 Problem №1): пересчёт cumulative_net_pnl_rub для ВСЕХ
+    строк с непустым net_pnl_rub в ГАРАНТИРОВАННОМ ХРОНОЛОГИЧЕСКОМ порядке
+    закрытия сделок (_row_chrono_key), а НЕ в порядке строк файла: порядок
+    строк = порядок записи (регистрации позиций) и не гарантирует хронологию
+    фактических закрытий; позднее восстановление метаданных старой сделки
+    меняет её net P&L и требует пересчёта всех последующих сделок.
+
+    Свойства:
+      * строки файла НЕ переставляются и их поля (кроме столбца
+        cumulative_net_pnl_rub) не изменяются;
+      * строки с пустым/нечисловым net_pnl_rub (PRICE_UNKNOWN) не меняются
+        (их cumulative остаётся как был — обычно пустой) и в сумму не входят;
+      * значения парсятся из строк CSV (округлены до 2 знаков при записи);
+      * РЕЗУЛЬТАТ ДЕТЕРМИНИРОВАН: одинаковый набор строк всегда даёт
+        одинаковые cumulative значения — независимо от порядка строк в
+        файле и числа повторов пересчёта (хронологический порядок +
+        стабильный tie-breaker trade_id + индекс строки).
+
+    Возвращает True, если хотя бы одна строка изменилась."""
+    entries = []
+    for idx, row in enumerate(rows):
+        raw = str(row.get("net_pnl_rub") or "").strip()
+        if not raw:
+            continue
+        try:
+            value = float(raw.replace(",", ".").replace(" ", ""))
+        except (TypeError, ValueError):
