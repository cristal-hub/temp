+def _report_value_conflict(saved, reported) -> bool:
+    """v2.3.5-stage1 (B2 metadata recovery): True — ТОЛЬКО когда ОБА значения
+    достоверны (не None) и различаются сверх денежного допуска.
+
+    Отсутствующее значение (None с любой стороны) — НЕ противоречие:
+    отсутствие данных в новом отчёте не равно несовпадению двух достоверных
+    значений. Непарсируемое «достоверное» значение трактуется консервативно
+    как конфликт (fail-closed). Семантика совпадает с
+    main._confirmed_value_conflicts (проверка идентичности повторов В2):
+    оба уровня защиты согласованно распознают противоречие отчёта."""
+    if saved is None or reported is None:
+        return False
+    try:
+        fs, fr = float(saved), float(reported)
+    except (TypeError, ValueError):
+        return True
+    return abs(fs - fr) > 1e-9
