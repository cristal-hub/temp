            позиции запрещена («воскрешение» закрытой позиции).
        """
        for rec in list(ledger.open_orders(side="BUY")):
            order_id = rec["order_id"]
            figi = rec.get("figi") or ""
            ticker = rec.get("ticker") or figi or "?"
    
