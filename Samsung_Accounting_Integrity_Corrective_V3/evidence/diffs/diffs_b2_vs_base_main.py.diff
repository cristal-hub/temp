+    for rec in list(getattr(monitor, "pending_csv_recoveries", []) or []):
+        trade_id = str(rec.get("trade_id") or "")
+        ticker = str(rec.get("ticker") or "?")
+        # --- v2.3.8-stage1 (B2 V5, Defect B): валидация идентичности ---
+        # Учитывается КАК свежая проверка снимка, ТАК и ранее установленный
+        # маркер (например, duplicate_trade_id_conflicting из import_state):
+        # заблокированная задача не «разблокируется» повторной проверкой.
+        try:
+            detected = ExecutionMonitor.validate_recovery_identity(rec)
+        except Exception as exc:
+            detected = f"validator_error:{type(exc).__name__}"
+        conflict = rec.get("conflict") or detected
+        if conflict is not None:
+            if rec.get("conflict") != conflict:
+                # Событие — только при первичном обнаружении/смене причины
+                # (без спама в журнале событий на каждом цикле).
+                rec["conflict"] = conflict
+                research_logger.log_event("CSV_RECOVERY_TASK_CONFLICT", {
+                    "trade_id": trade_id, "figi": rec.get("figi"),
+                    "reason": conflict, "stage": "process_closing",
+                })
+            logging.error(
+                f"[csv-recovery] {ticker}: задача trade_id={trade_id or '?'} "
+                f"— конфликт идентичности ({conflict}): брокер не опрашивается, "
+                f"CSV не изменяется, задача не завершается (fail-closed)")
+            continue
+        if not trade_id:
+            continue
+        try:
+            task_pos = TrackedPosition.from_dict(rec.get("position") or {})
+        except Exception as exc:
+            # Снимок невосстановим (повреждён в памяти): задача НЕ удаляется
+            # и НЕ считается завершённой (v2.3.8-stage1, Defect B) — ни одна
+            # строка CSV и ни один учётный объект не затронуты (fail-closed).
+            if rec.get("conflict") != "snapshot_unrestorable":
+                rec["conflict"] = "snapshot_unrestorable"
+                research_logger.log_event("CSV_RECOVERY_TASK_CONFLICT", {
+                    "trade_id": trade_id, "figi": rec.get("figi"),
+                    "reason": "snapshot_unrestorable",
+                    "detail": f"{type(exc).__name__}: {exc}",
+                    "stage": "process_closing",
+                })
+            logging.error(
+                f"[csv-recovery] {ticker}: снимок задачи trade_id={trade_id} "
+                f"невосстановим ({type(exc).__name__}: {exc}) — задача "
+                f"остаётся с маркером конфликта, CSV не изменён (fail-closed)")
+            continue
+        try:
+            await _recover_late_csv_metadata(client, task_pos)
+        except Exception as exc:
+            logging.error(
+                f"[csv-recovery] {ticker}: сбой восстановления архивной "
+                f"задачи trade_id={trade_id}: {type(exc).__name__}: {exc} "
+                f"— учёт и CSV не изменены")
+            continue
+        # Снимок задачи синхронизируется с рабочим состоянием (обогащение
+        # cursor'а поздними метаданными) — тогда конфликт ЛЮБОГО позднего
+        # отчёта с уже подтверждённым значением обнаружится и после
+        # перезапуска (та же защита, что у живых позиций в state.json).
+        try:
+            rec["position"] = task_pos.to_dict()
+        except Exception:
+            pass  # снимок остаётся прежним — recovery идемпотентен
+        # Завершение задачи: в строке подтверждены И цена, И фактическая
+        # комиссия (критерий совпадает с самоограничением опроса v3).
+        find_status, rec_row = research_logger.find_trade_row(trade_id)
+        if find_status == "found" and rec_row is not None:
+            rec_price = str(rec_row.get("exit_price") or "").strip()
+            rec_comm = str(rec_row.get("actual_commission_rub") or "").strip()
+            if rec_price and rec_comm:
+                if rec in monitor.pending_csv_recoveries:
+                    monitor.pending_csv_recoveries.remove(rec)
+                logging.info(
+                    f"[csv-recovery] {ticker}: задача trade_id={trade_id} "
+                    f"завершена (цена и фактическая комиссия подтверждены "
+                    f"в CSV) — удалена из очереди восстановления")
+                research_logger.log_event("CSV_RECOVERY_TASK_COMPLETED", {
+                    "trade_id": trade_id, "figi": rec.get("figi"),
+                    "ticker": rec.get("ticker"),
+                })
+
+
