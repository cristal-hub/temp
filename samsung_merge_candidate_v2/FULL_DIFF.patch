+def _confirmed_value_conflicts(saved, reported) -> bool:
+    """v2.3.4-stage2 (Дефект-2): True — ТОЛЬКО когда ОБА значения достоверны
+    (не None) и различаются сверх денежного допуска.
+
+    Отсутствующее значение (None с любой стороны) — НЕ противоречие:
+    отсутствие данных в новом отчёте (например, отчёт впервые не передал
+    комиссию, которая уже сохранена в cursor'е) не равно несовпадению двух
+    достоверных значений. Непарсируемое «достоверное» значение трактуется
+    консервативно как конфликт (fail-closed)."""
+    if saved is None or reported is None:
+        return False
+    try:
+        fs, fr = float(saved), float(reported)
+    except (TypeError, ValueError):
+        return True
+    return abs(fs - fr) > 1e-9
+
